<?xml version="1.0" encoding="utf-8"?>
<!-- 关注的直播 Compact（高 &lt; 130dp）：在播人数徽章 + 3 个在播头像/昵称。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/live_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_pill"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:textColor="#E6E1E5"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/live_col_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/live_avatar_1"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_avatar_icon" />

        <TextView
            android:id="@+id/live_author_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#A8A4AF"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/live_col_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/live_avatar_2"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_avatar_icon" />

        <TextView
            android:id="@+id/live_author_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#A8A4AF"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/live_col_3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/live_avatar_3"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_avatar_icon" />

        <TextView
            android:id="@+id/live_author_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#A8A4AF"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
