<?xml version="1.0" encoding="utf-8"?>
<!-- 关注的直播 Expanded（高 &gt;= 130dp）：更新时间 + 3 行「昵称 / 标题 / 在看人数」。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_ic_live" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="关注的直播"
            android:textColor="#E6E1E5"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/live_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#A8A4AF"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/live_row_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_avatar_icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/live_author_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#E6E1E5"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/live_title_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#A8A4AF"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/live_viewers_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#7E7A86"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/live_row_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_avatar_icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/live_author_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#E6E1E5"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/live_title_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#A8A4AF"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/live_viewers_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#7E7A86"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/live_row_3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_avatar_icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/live_author_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#E6E1E5"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/live_title_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#A8A4AF"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/live_viewers_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#7E7A86"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
