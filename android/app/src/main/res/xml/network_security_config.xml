<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 明文流量必须放行：
         1) 抖音直播 flv/hls 拉流地址大量是 http://，拦截后播放器只报笼统的「Source error」；
         2) 局域网面板（9978/9979）走 HTTP。
         仍保留系统/用户证书信任锚，避免自签证书场景下握手失败。 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
